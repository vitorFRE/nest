NODE_ENV=development
APP_NAME="Nest Template API"
PORT=3000
API_PREFIX=api
APP_CORS_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true
# Número de proxies confiáveis entre o cliente e a API; 0 para acesso direto.
TRUST_PROXY_HOPS=0

# SQLite local. Caminho relativo à raiz do projeto.
LOCAL_DATABASE_URL=file:./dev.db
# Em produção a aplicação usa somente Turso.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Execute pnpm setup:env para criar .env com segredos aleatórios.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
# Se omitido: true em development/test e false em production.
ALLOW_REGISTRATION=true

# Usadas somente por pnpm users:create-admin; não salve a senha em arquivos.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=
